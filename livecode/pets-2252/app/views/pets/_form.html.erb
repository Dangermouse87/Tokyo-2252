<!-- Simple Form -->

<%= simple_form_for pet, html: { class: "container mt-4" } do |f| %>
  <%= f.input :name,
              input_html: { class: "form-control" },
              label_html: { class: "form-label" } %>
  <%= f.input :address,
              input_html: { class: "form-control" },
              label_html: { class: "form-label" } %>
  <%= f.input :species,
              collection: Pet::SPECIES.sort,
              include_blank: false,
              input_html: { class: "form-select" },
              label_html: { class: "form-label" } %>
  <%= f.input :found_on,
              as: :date,
              html5: true,
              input_html: { class: "form-control" },
              label_html: { class: "form-label" } %>
  <%= f.submit "Add", class: "btn btn-success mt-3" %>
<% end %>