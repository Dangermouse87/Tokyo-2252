<div class="container">
  <div class="row justify-content-center">
    <div class="col-4">
      <h4>Add a dinosaur:</h4>
      <%= simple_form_for [@park, @dinosaur] do |f| %>
        <%= f.input :name, placeholder: "Doyouthinkhesaurus" %>
        <%= f.input :image_url, placeholder: "https://some_nice_image_found_on_google.jpg" %>
        <%= f.submit "Add", class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>
</div>