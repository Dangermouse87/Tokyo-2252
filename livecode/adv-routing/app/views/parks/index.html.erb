<% if notice %>
  <div class="container mt-3">
    <div class="alert alert-success" role="alert"><%= notice %></div>
  </div>
<% end %>

<div class="container my-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="parks-title mb-0">
      <i class="fa-solid fa-dragon me-2"></i>Parks
    </h1>
    <%= link_to new_park_path, class: "btn btn-primary" do %>
      <i class="fa-solid fa-plus me-2"></i>New park
    <% end %>
  </div>

  <div class="row g-4">
    <% @parks.each do |park| %>
      <div class="col-lg-4 col-md-6">
        <%= link_to park, class: "park-card shadow-sm" do %>
          <div class="park-card__image" style="background-image: linear-gradient(rgba(0,0,0,0.15), rgba(0,0,0,0.65)), url('<%= park.banner_url %>');">
            <h3 class="park-card__name"><%= park.name %></h3>
          </div>
          <div class="park-card__footer">
            <span class="park-card__cta">
              Explore park <i class="fa-solid fa-arrow-right ms-1"></i>
            </span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
